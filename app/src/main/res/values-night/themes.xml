    <style name="SearchViewStyle">
        <item name="android:textSize">@dimen/_10sdp</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
    </style>

    <style name="RatingBar_Wall" parent="Theme.AppCompat">
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlActivated">@color/rating</item>
    </style>


    <style name="SearchWebViewStyle">
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="closeIcon">@null</item>
        <item name="defaultQueryHint">@string/type_in_your_search</item>
        <item name="queryHint">@string/type_in_your_search</item>
        <item name="searchHintIcon">@null</item>
    </style>

    <style name="CustomDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <!--        <item name="android:windowDimAmount">0.5</item>-->
    </style>

    <style name="AppBottomSheetDialogTheme">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle">
        <item name="android:background">@drawable/layout_bg</item>
    </style>

    <style name="NumberPickerStyle">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:colorControlNormal">@color/white</item>
    </style>

    <style name="YTOSecondsTextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TrackSelectionDialogThemeOverlay" parent="Theme.AppCompat.Dialog">
        <item name="windowNoTitle">false</item>
    </style>

    <style name="TabTextStyle">
        <item name="android:textAllCaps">false</item> <!-- Ensure no capitalization -->
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppin_medium</item>
    </style>
</resources>